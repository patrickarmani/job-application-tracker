@model IEnumerable<JobApplicationTracker.Models.JobApplication>

@{
    ViewData["Title"] = "Home Page";
}

<div class="">
    <h1 class="display-6">Dashboard - Welcome</h1>
    <p class="text-muted">You have -@ViewData["ApplicationCount"]- applications.</p>
    <section class="d-flex">
        <div class="card mb-4 p-4 bg-light w-25 h-25">
            <span>@ViewData["Status"]</span>
            <span>@ViewData["ApplicationCount"]</span>
            <p>Applications@* @(ViewData["ApplicationCount"] != null && (int)ViewData["ApplicationCount"] != 1 ? "s" : "") *@
            </p>
        </div>
    </section>
    <section class="mt-4">
        <div class="d-flex justify-content-between align-items-center">
            <h2>Recent Applications</h2>
            <a class="btn btn-primary" asp-controller="JobApplications" asp-action="Create">+ New
                application</a>
            </div>
        </div>
        @if (!Model.Any())
        {
            <p class="text-muted">No recent applications.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle table-bordered border-dark">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" scope="col">Company</th>
                            <th class="text-center" scope="col">Position</th>
                            <th class="text-center" scope="col">Applied</th>
                            <th class="text-center" scope="col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            <tr>
                                <td>@app.Company</td>
                                <td>@app.Position</td>
                                <td>@app.ApplicationDate.ToShortDateString()</td>
                                <td>@app.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
