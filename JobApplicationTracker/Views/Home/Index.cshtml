@model IEnumerable<JobApplicationTracker.Models.JobApplication>

@{
    ViewData["Title"] = "Home Page";
}

<div class="">
    <h1 class="display-6">Dashboard - Welcome</h1>
    <p class="text-muted">You have @Model.Count() application@(Model.Count() != 1 ? "s" : "")</p>
    <section class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3 mb-4">
        @* Use the foreach to loop through each application status *@
        @foreach (var app in Model)
        {
            <div class="">
                <div class="card bg-light w-100 h-100 text-center p-2">
                    <span>@app.Status</span>
                    @* Make the count dynamic based on the status *@
                    <span>@Model.Count(a => a.Status == app.Status)</span>
                    <span>application@(Model.Count(a => a.Status == app.Status) != 1 ? "s" : "")</span>
                </div>
            </div>
        }
    </section>
    <section class="mt-4">
        <div class="d-flex justify-content-between align-items-center">
            <h2>Recent Applications</h2>
            <a class="btn btn-primary" asp-controller="JobApplications" asp-action="Create">+ New
                application</a>
            </div>
        </div>
        @if (!Model.Any())
        {
            <p class="text-muted">No recent applications.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle table-bordered border-dark">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Company</th>
                            <th scope="col">Position</th>
                            <th scope="col">Applied</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            <tr>
                                <td>@app.Company</td>
                                <td>@app.Position</td>
                                <td>@app.ApplicationDate.ToShortDateString()</td>
                                <td>@app.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
