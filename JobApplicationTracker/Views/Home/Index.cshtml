@model IEnumerable<JobApplicationTracker.Models.JobApplication>

@{
    ViewData["Title"] = "Home Page";
}

<div class="">
    <h1 class="display-6 secondary-text fw-medium mb-0">Dashboard - Welcome</h1>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="text-muted mb-0">You have @Model.Count() application@(Model.Count() != 1 ? "s" : "")</p>
        <a class="btn btn-primary" asp-controller="JobApplications" asp-action="Create">+ New
            application</a>
        </div>
    </div>
    <section class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3 mb-4">
        @* Instead of creating a card for each application, we create a card for each application status *@
        @{
            var statuses = Model.Select(a => a.Status).Distinct();
        }
        @foreach (var status in statuses)
        {
            <div>
                <div class="dashboard-card w-100 h-100 text-center p-2">
                    <span class="card-badge-text">@status</span>
                    <span class="fw-bold fs-4">@Model.Count(a => a.Status == status)</span>
                    <span>Application@(Model.Count(a => a.Status == status) != 1 ? "s" : "")</span>
                </div>
            </div>
        }
    </section>
    <section class="mt-4">
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="mb-3">Recent Applications</h2>
            <a class="fw-medium fs-5 view-all-link" asp-controller="JobApplications" asp-action="Index">View All</a>
        </div>
        @if (!Model.Any())
        {
            <p class="text-muted">No recent applications.</p>
        }
        else
        {
            <div class="table-responsive border rounded table-border">
                <table class="table table-blue table-bordered mb-0">
                    <thead class="">
                        <tr>
                            <th scope="col">Company</th>
                            <th scope="col">Position</th>
                            <th scope="col">Applied</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    @* Only display the last 4 *@
                    <tbody>
                        @foreach (var app in Model.OrderByDescending(a => a.ApplicationDate).Take(4))
                        {
                            <tr>
                                <td>@app.Company</td>
                                <td>@app.Position</td>
                                <td>@app.ApplicationDate.ToString("MMM d, yyyy", new System.Globalization.CultureInfo("en-US"))</td>
                                <td>@app.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
