@{
    ViewData["Title"] = "Job Applications";
}
@model IEnumerable<JobApplicationTracker.Models.JobApplication>

<div>
    <h1 class="display-5">Job Applications</h1>
    @* This will be a filter to search by company or position *@
    @* This will be an input for all statuses where the user can select a single status from the select dropdown *@
    <div>
        @* I'll display all job applications here from the database *@
        <article class="card w-100">
            @foreach (var app in Model)
            {
                <div class="card-body">
                    <h2>@app.Company</h2>
                    <p>@app.Position</p>
                    <p>@app.ApplicationDate.ToShortDateString()</p>
                    <p>@app.Status</p>
                </div>
            }
        </article>
    </div>
</div>