@{
    ViewData["Title"] = "Delete Application";
}

@model JobApplication

<h1 class="h3 mb-4">Delete application</h1>
<p class="text-muted">Are you sure you want to delete this application?</p>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>

<div class="alert alert-warning mt-4" role="alert">
    <strong>This action will be permanent and cannot be undone.</strong>
</div>

<div class="mt-4">
    <h4>Application Details</h4>
    <dl class="row">
        <dt class="col-sm-3">Company</dt>
        <dd class="col-sm-9">@Model.Company</dd>

        <dt class="col-sm-3">Position</dt>
        <dd class="col-sm-9">@Model.Position</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            <partial name="_StatusBadge" model="Model.Status" />
        </dd>

        <dt class="col-sm-3">Applied Date</dt>
        <dd class="col-sm-9">@Model.ApplicationDate.ToShortDateString()</dd>

        <dt class="col-sm-3">Notes</dt>
        <dd class="col-sm-9">@Model.Notes</dd>
    </dl>
</div>
