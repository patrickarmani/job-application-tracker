@{
    ViewData["Title"] = "Application Details";
}

@model JobApplication

<h1 class="h3 mb-4">Application Details</h1>

<div class="border p-3 rounded">
    <dl class="row">
        <dt class="col-sm-3">Company</dt>
        <dd class="col-sm-9">@Model.Company</dd>

        <dt class="col-sm-3">Position</dt>
        <dd class="col-sm-9">@Model.Position</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            <partial name="_StatusBadge" model="Model.Status" />
        </dd>

        <dt class="col-sm-3">Applied Date</dt>
        <dd class="col-sm-9">@Model.ApplicationDate.ToShortDateString()</dd>

        <dt class="col-sm-3">Notes</dt>
        <dd class="col-sm-9">@Model.Notes</dd>
    </dl>
    <div class="d-flex gap-2 mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-danger">Delete</a>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to list</a>
    </div>

</div>
