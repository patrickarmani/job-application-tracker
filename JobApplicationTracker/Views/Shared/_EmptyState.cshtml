@model bool
@* Model = true when a search or status filter is active *@

<div class="text-center border rounded p-5 my-4">
    @if (Model)
    {
        <h2 class="h4 secondary-text fw-medium">No applications match your search</h2>
        <p class="text-muted mb-4">Try a different company or position, or choose another status.</p>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear search and filters</a>
    }
    else
    {
        <h2 class="h4 secondary-text fw-medium">No applications yet</h2>
        <p class="text-muted mb-4">Start tracking your job search by adding your first application.</p>
        <a asp-action="Create" class="btn btn-primary">+ New application</a>
    }
</div>
