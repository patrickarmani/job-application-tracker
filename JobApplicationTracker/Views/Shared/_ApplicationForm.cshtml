@model JobApplication


<label asp-for="Company" class="d-block">Company*</label>
<input asp-for="Company" class="form-control" />
<span asp-validation-for="Company" class="text-danger small d-block" style="min-height: 1.3rem""
      style="min-height: 1.3rem""></span>
<label asp-for=" Position" class="d-block">Position*</label>
<input asp-for="Position" class="form-control" />
<span asp-validation-for="Position" class="text-danger small d-block" style="min-height: 1.3rem""></span>
<label asp-for=" JobUrl" class="d-block">Job Posting URL*</label>
<input asp-for="JobUrl" class="form-control" />
<span asp-validation-for="JobUrl" class="text-danger small d-block" style="min-height: 1.3rem""></span>
<label asp-for=" Location" class="d-block">Location</label>
<input asp-for="Location" class="form-control" />
<span asp-validation-for="Location" class="text-danger small d-block" style="min-height: 1.3rem"></span>
<label asp-for=" WorkModel" class="d-block">Work Model*</label>
<input type="radio" id="workModelOnSite" asp-for="WorkModel" value="Onsite">
<label for="workModelOnSite">Onsite</label>
<input type="radio" id="workModelRemote" asp-for="WorkModel" value="Remote">
<label for="workModelRemote">Remote</label>
<input type="radio" id="workModelHybrid" asp-for="WorkModel" value="Hybrid">
<label for="workModelHybrid">Hybrid</label>
<span asp-validation-for="WorkModel" class="text-danger small d-block" style="min-height: 1.3rem"
      d-block"></span>
<label asp-for="ApplicationDate" class="d-block">Application Date*</label>
<input asp-for="ApplicationDate" class="form-control" />
<span asp-validation-for="ApplicationDate" class="text-danger small d-block" style="min-height: 1.3rem""></span>
<label asp-for=" Status" class="d-block">Status*</label>
<select asp-for="Status" asp-items="Html.GetEnumSelectList<ApplicationStatus>()" class="form-select">
    <option value="">-- Select a status --</option>
</select>
<span asp-validation-for="Status" class="text-danger small d-block" style="min-height: 1.3rem""></span>
<label asp-for=" Notes" class="d-block">Notes</label>
<textarea asp-for="Notes" class="form-control mb-3"></textarea>